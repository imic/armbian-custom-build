+static int smb5_get_prop_input_suspend(struct smb5_chip *chip, int *val)
+{
+	unsigned int cmd;
+	int rc;
+
+	rc = regmap_read(chip->regmap, chip->base + USBIN_CMD_IL, &cmd);
+	if (rc < 0)
+		return rc;
+
+	*val = !!(cmd & USBIN_SUSPEND_BIT);
+	return 0;
+}
+
+static int smb5_set_prop_input_suspend(struct smb5_chip *chip, int val)
+{
+	return regmap_update_bits(chip->regmap, chip->base + USBIN_CMD_IL,
+				  USBIN_SUSPEND_BIT,
+				  val ? USBIN_SUSPEND_BIT : 0);
+}
