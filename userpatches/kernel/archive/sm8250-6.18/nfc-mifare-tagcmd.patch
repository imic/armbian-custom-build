nfc: NCI: add MIFARE Classic support via NXP TAG-CMD interface (0x80)

The NXP SN100T (PN7160 family) exposes MIFARE Classic authentication
and reads only through its proprietary RF protocol/interface 0x80.
Teach the NCI core to map that interface at discovery, select it for
Classic targets and report it to the nxp-nci driver, which advertises
the targets as NFC_PROTO_MIFARE. All paths are gated on the
controller actually advertising interface 0x80 or a target actually
being discovered with protocol 0x80; behaviour for every other
controller and card type is unchanged. Verified on OnePlus 8T
(SN100T): full Classic 1K read through the TAG-CMD path.

--- a/include/net/nfc/nci.h
+++ b/include/net/nfc/nci.h
@@ -112,12 +112,16 @@
 #define NCI_RF_PROTOCOL_ISO_DEP					0x04
 #define NCI_RF_PROTOCOL_NFC_DEP					0x05
 #define NCI_RF_PROTOCOL_T5T					0x06
+/* NXP proprietary RF protocol: MIFARE Classic via TAG-CMD */
+#define NCI_RF_PROTOCOL_MIFARE_CLASSIC			0x80
 
 /* NCI RF Interfaces */
 #define NCI_RF_INTERFACE_NFCEE_DIRECT				0x00
 #define NCI_RF_INTERFACE_FRAME					0x01
 #define NCI_RF_INTERFACE_ISO_DEP				0x02
 #define NCI_RF_INTERFACE_NFC_DEP				0x03
+/* NXP proprietary RF interface for T2T/MIFARE Classic commands */
+#define NCI_RF_INTERFACE_TAG_CMD				0x80
 
 /* NCI Configuration Parameter Tags */
 #define NCI_PN_ATR_REQ_GEN_BYTES				0x29
--- a/include/net/nfc/nci_core.h
+++ b/include/net/nfc/nci_core.h
@@ -90,7 +90,7 @@
 	size_t n_core_ops;
 };
 
-#define NCI_MAX_SUPPORTED_RF_INTERFACES		4
+#define NCI_MAX_SUPPORTED_RF_INTERFACES		32
 #define NCI_MAX_DISCOVERED_TARGETS		10
 #define NCI_MAX_NUM_NFCEE   255
 #define NCI_MAX_CONN_ID		7
--- a/include/net/nfc/nfc.h
+++ b/include/net/nfc/nfc.h
@@ -104,6 +104,7 @@
 	u8 sensf_res[NFC_SENSF_RES_MAXSIZE];
 	u8 hci_reader_gate;
 	u8 logical_idx;
+	u8 rf_protocol;		/* RF protocol reported at discovery (NCI) */
 	u8 is_iso15693;
 	u8 iso15693_dsfid;
 	u8 iso15693_uid[NFC_ISO15693_UID_MAXSIZE];
--- a/net/nfc/nci/core.c
+++ b/net/nfc/nci/core.c
@@ -203,6 +203,12 @@
 				NCI_DISC_MAP_MODE_LISTEN;
 			cfg[*num].rf_interface = NCI_RF_INTERFACE_NFC_DEP;
 			(*num)++;
+		} else if (ndev->supported_rf_interfaces[i] ==
+			   NCI_RF_INTERFACE_TAG_CMD) {
+			cfg[*num].rf_protocol = NCI_RF_PROTOCOL_MIFARE_CLASSIC;
+			cfg[*num].mode = NCI_DISC_MAP_MODE_POLL;
+			cfg[*num].rf_interface = NCI_RF_INTERFACE_TAG_CMD;
+			(*num)++;
 		}
 
 		if (*num == NCI_MAX_NUM_MAPPING_CONFIGS)
@@ -321,6 +327,10 @@
 		cmd.rf_interface = NCI_RF_INTERFACE_NFC_DEP;
 		break;
 
+	case NCI_RF_PROTOCOL_MIFARE_CLASSIC:
+		cmd.rf_interface = NCI_RF_INTERFACE_TAG_CMD;
+		break;
+
 	default:
 		cmd.rf_interface = NCI_RF_INTERFACE_FRAME;
 		break;
@@ -944,6 +954,10 @@
 
 		if (protocol == NFC_PROTO_JEWEL)
 			param.rf_protocol = NCI_RF_PROTOCOL_T1T;
+		else if (protocol == NFC_PROTO_MIFARE &&
