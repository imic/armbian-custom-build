 		else if (protocol == NFC_PROTO_MIFARE)
 			param.rf_protocol = NCI_RF_PROTOCOL_T2T;
 		else if (protocol == NFC_PROTO_FELICA)
--- a/net/nfc/nci/ntf.c
+++ b/net/nfc/nci/ntf.c
@@ -319,6 +319,8 @@
 	const struct rf_tech_specific_params_nfcv_poll *nfcv_poll;
