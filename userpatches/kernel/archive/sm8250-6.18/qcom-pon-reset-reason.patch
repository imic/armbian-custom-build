power: reset: qcom-pon: log previous power-cycle reason at probe

The GEN2 PON block latches why the previous power cycle ended
(PS_HOLD, charger, watchdog, ...). Print both reason registers once
at probe so the cause of an unexpected reset is in the boot log of
any rootfs; on devices whose boot chain scrubs RAM, pstore cannot
provide this. Read failures are silent and never fail the probe.

--- a/drivers/power/reset/qcom-pon.c
+++ b/drivers/power/reset/qcom-pon.c
@@ -14,6 +14,15 @@
 
 #define PON_SOFT_RB_SPARE		0x8f
 
+/* GEN2 PON power-cycle reason registers (offsets from the PON base) */
+#define PON_REASON1			0x05
+#define PON_REASON2			0x06
+
+/* PON_REASON1 bit latched when the reset was caused by PS_HOLD,
+ * i.e. a software-requested reset (verified on PM8150).
+ */
+#define PON_REASON1_PS_HOLD		BIT(2)
+
 #define GEN1_REASON_SHIFT		2
 #define GEN2_REASON_SHIFT		1
 
@@ -44,6 +53,38 @@
 	return ret;
 }
 
+/*
+ * The PON peripheral latches the cause of the previous power cycle in
+ * registers that survive the reset itself. Log them so the reason is
+ * part of the kernel log of every boot, on any rootfs; this cannot be
+ * delegated to pstore on devices whose boot chain scrubs RAM. The
+ * register offsets follow the GEN2 PON layout (downstream
+ * qpnp-power-on); other generations are skipped.
+ */
+static void qcom_pon_log_reset_reason(struct qcom_pon *pon)
+{
+	unsigned int reason1, reason2;
+	int error;
+
+	if (pon->reason_shift != GEN2_REASON_SHIFT)
+		return;
+
+	error = regmap_read(pon->regmap, pon->baseaddr + PON_REASON1,
+			    &reason1);
+	if (error)
+		return;
+	error = regmap_read(pon->regmap, pon->baseaddr + PON_REASON2,
+			    &reason2);
+	if (error)
+		return;
+
+	dev_info(pon->dev,
+		 "previous power cycle: pon_reason1=0x%02x pon_reason2=0x%02x%s\n",
+		 reason1, reason2,
+		 (reason1 & PON_REASON1_PS_HOLD) ?
+			" (PS_HOLD: software reset)" : "");
+}
+
 static int qcom_pon_probe(struct platform_device *pdev)
 {
 	struct qcom_pon *pon;
@@ -80,6 +121,8 @@
 		}
 	}
 
+	qcom_pon_log_reset_reason(pon);
+
 	platform_set_drvdata(pdev, pon);
 
 	return devm_of_platform_populate(&pdev->dev);
