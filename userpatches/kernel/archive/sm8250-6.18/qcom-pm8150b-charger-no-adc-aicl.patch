--- a/drivers/power/supply/qcom_pm8150b_charger.c
+++ b/drivers/power/supply/qcom_pm8150b_charger.c
@@ -793,10 +793,19 @@
 	 * When connected to a wall charger, and automatically stop when it detects
 	 * the charger current limit (voltage drop?) or it reaches the programmed limit.
 	 */
+	/*
+	 * Do not enable ADC based AICL: downstream only enables it when
+	 * the DT explicitly requests it (adc-based-aicl), and this driver
+	 * has no such DT plumbing. With ADC_EN set, AICL is observed to
+	 * conclude the minimum 50 mA step on every source tried, pinning
+	 * the effective input current limit at 50 mA regardless of the
+	 * APSD-programmed limit. Keep the bit in the mask so it is
+	 * actively cleared; AICL keeps working via its analog path.
+	 */
 	{ .addr = USBIN_AICL_OPTIONS_CFG,
 	  .mask = USBIN_AICL_PERIODIC_RERUN_EN_BIT | USBIN_AICL_ADC_EN_BIT
 			| USBIN_AICL_EN_BIT | SUSPEND_ON_COLLAPSE_USBIN_BIT,
-	  .val = USBIN_AICL_PERIODIC_RERUN_EN_BIT | USBIN_AICL_ADC_EN_BIT
+	  .val = USBIN_AICL_PERIODIC_RERUN_EN_BIT
 			| USBIN_AICL_EN_BIT | SUSPEND_ON_COLLAPSE_USBIN_BIT },
 };
 
