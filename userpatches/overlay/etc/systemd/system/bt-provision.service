[Unit]
Description=Provision Bluetooth public address (QCA6390 unconfigured controller)
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/bt-provision.sh
# Hard backstop: provisioning must never stall the boot, even if
# a btmgmt call wedges against a half-up controller.
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
